{
  "name": "front-trt",
  "version": "1.0.0",
  "description": "Frontend para el sistema de Refaccionaria TRT",
  "author": "Refaccionaria TRT",
  "homepage": "https://fronttrt.com",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "web": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "build:installer": "npm run build:prod && electron-builder",
    "build:win": "electron-builder --windows",
    "build:installer:win": "./build-win.sh",
    "electron": "electron .",
    "electron:dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "electron:prod": "npm run build:prod && electron .",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "fuse.js": "^7.1.0",
    "lucide-angular": "^0.577.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-builders/jest": "^18.0.0",
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jest": "^30.0.0",
    "concurrently": "^9.2.1",
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "typescript": "~5.5.2",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.fronttrt.app",
    "productName": "FrontTRT",
    "copyright": "Copyright © 2024",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/front-trt/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "maintainer": "Refaccionaria TRT <admin@fronttrt.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
